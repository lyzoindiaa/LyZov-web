{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "frontend/client/dist/**"
    },
    "index.js": {
      "includeFiles": "frontend/client/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
