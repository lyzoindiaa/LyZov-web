{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "frontend/client/dist/**"
    },
    "index.js": {
      "includeFiles": "frontend/client/dist/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(index.html)?",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__p=/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__p=/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=/api/:path*"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-settlements",
      "schedule": "0 */6 * * *"
    }
  ]
}
