{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "frontend/client/dist/**"
    },
    "index.js": {
      "includeFiles": "frontend/client/dist/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(index.html)?",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__p=/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__p=/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=/api/:path*"
    },
    {
      "source": "/shop",
      "destination": "/api/index?__p=/shop"
    },
    {
      "source": "/products",
      "destination": "/api/index?__p=/products"
    },
    {
      "source": "/category/:path*",
      "destination": "/api/index?__p=/category/:path*"
    },
    {
      "source": "/product/:path*",
      "destination": "/api/index?__p=/product/:path*"
    },
    {
      "source": "/policies",
      "destination": "/api/index?__p=/policies"
    },
    {
      "source": "/policies/:path*",
      "destination": "/api/index?__p=/policies/:path*"
    },
    {
      "source": "/contact",
      "destination": "/api/index?__p=/contact"
    },
    {
      "source": "/track",
      "destination": "/api/index?__p=/track"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
